<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- Deliberately dependency-free apart from the DI abstractions: this is a root library that
         non-web class libraries (application layers, workers, seeders) reference to override the
         ambient identity without pulling in Microsoft.AspNetCore.App. -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    </ItemGroup>

</Project>
